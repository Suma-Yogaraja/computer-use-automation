{
  "id": "member.lookup_balance",
  "version": "1.0.0",
  "name": "Member Balance Lookup",
  "description": "Log in and look up savings and checking account balances for a member by ID",
  "target": "http://localhost:8080/login",
  "compatibility": {
    "vendor": "demo-bank",
    "app_version": "1.0",
    "surface": "web"
  },
  "parameters": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "pattern": "^\\d{5}$",
      "sensitivity": "internal"
    },
    {
      "name": "username",
      "type": "string",
      "required": true,
      "sensitivity": "secret"
    },
    {
      "name": "password",
      "type": "string",
      "required": true,
      "sensitivity": "secret"
    }
  ],
  "outputs": [
    { "name": "savings_balance",  "type": "string", "sensitivity": "financial_data" },
    { "name": "checking_balance", "type": "string", "sensitivity": "financial_data" }
  ],
  "outcome_detectors": [
    {
      "code": "SESSION_EXPIRED",
      "detector_type": "page_contains_text",
      "value": "Your session has expired",
      "disposition": "HARD_FAILURE",
      "priority": 2
    },
    {
      "code": "APP_ERROR",
      "detector_type": "page_contains_text",
      "value": "An unexpected server error occurred",
      "disposition": "HARD_FAILURE",
      "priority": 3
    },
    {
      "code": "MEMBER_NOT_FOUND",
      "detector_type": "page_contains_text",
      "value": "No member found with ID",
      "disposition": "BUSINESS_OUTCOME",
      "priority": 10
    },
    {
      "code": "ACCOUNT_FROZEN",
      "detector_type": "page_contains_text",

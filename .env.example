# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required for cli.py discover and test_discovery.py
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the LLM model used by the discovery agent
# Default: claude-sonnet-4-6
# DISCOVERY_MODEL=claude-haiku-4-5-20251001

# Optional: override the mock banking app port
# Default: 8080
# PORT=8080

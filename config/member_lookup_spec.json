{
  "capability_id": "member.lookup_balance",
  "capability_name": "Member Balance Lookup",
  "goal": "Look up savings and checking account balances for a member using member_id, starting from the authenticated dashboard.",
  "target_url": "http://localhost:8080/dashboard",
  "parameters": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "pattern": "^\\d{5}$",
      "sensitivity": "internal"
    }
  ],
  "outputs": [
    { "name": "savings_balance",  "type": "string", "sensitivity": "financial_data" },
    { "name": "checking_balance", "type": "string", "sensitivity": "financial_data" }
  ],
  "outcome_detectors": [
    {
      "code": "SESSION_EXPIRED",
      "detector_type": "page_contains_text",
      "value": "Your session has expired",
      "disposition": "HARD_FAILURE",
      "priority": 2
    },
    {
      "code": "APP_ERROR",
      "detector_type": "page_contains_text",
      "value": "An unexpected server error occurred",
      "disposition": "HARD_FAILURE",
      "priority": 3
    },
    {
      "code": "MEMBER_NOT_FOUND",
      "detector_type": "page_contains_text",
      "value": "No member found with ID",
      "disposition": "BUSINESS_OUTCOME",
      "priority": 10
    },
    {
      "code": "ACCOUNT_FROZEN",
      "detector_type": "page_contains_text",
      "value": "Frozen",
      "disposition": "BUSINESS_OUTCOME",
      "priority": 10
    }
  ]
}
